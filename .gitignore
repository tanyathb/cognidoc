###############################################################################
# 1. Azure Cloud, Functions & Sensitive Secrets (CRITICAL)
###############################################################################
# Local runtime secrets and settings
local.settings.json
local.settings.*.json
secrets.env
worker.config.json

# Local storage emulator (Azurite) artifacts
__blobstorage__/
__queuestorage__/
__tablestorage__/
*.vhd
*.bak

# Azurite local emulator storage files
__azurite_*
AzuriteConfig
.azurite/
*.azurite*

# Azure CLI and deployment temp files
.azure/
*.bicep.json

###############################################################################
# 2. .NET / C# / Visual Studio
###############################################################################
# Build and binary outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
publish/
**/publish/

# IDE and tooling cache
.vs/
.idea/
*.user
*.userosscache
*.suo
*.sln.docstates
*.DotSettings.user

# VS Code (preserve shared project configs, ignore workspace/user cache)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Test and coverage artifacts
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml

# NuGet restore artifacts
packages/
project.lock.json
project.assets.json

###############################################################################
# 3. React Frontend (Node, Vite, Build Artifacts)
###############################################################################
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production builds
frontend/**/dist/
frontend/**/build/
dist/
build/

# Local frontend environment variables
.env
.env.local
.env.*.local

# Tooling caches
.eslintcache
.stylelintcache
.vite/

###############################################################################
# 4. OS Specific Files
###############################################################################
.DS_Store
Thumbs.db
Desktop.ini
